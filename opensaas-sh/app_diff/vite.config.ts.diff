--- template/app/vite.config.ts
+++ opensaas-sh/app/vite.config.ts
@@ -1,10 +1,36 @@
 import tailwindcss from "@tailwindcss/vite";
-import { defineConfig } from "vite";
+import { existsSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { defineConfig, type Plugin } from "vite";
 import { wasp } from "wasp/client/vite";
+import { generateLlmsTxt } from "./scripts/generate-llms-txt.mjs";
+
+// Wasp only loads `.env.client` in development, so production builds would miss
+// the client env vars (e.g. the Google Analytics ID) unless they're passed on the
+// command line. Loading it here makes them part of every build, whatever deploy
+// command is used. Vars already set in the environment take precedence.
+const envClientFile = fileURLToPath(new URL(".env.client", import.meta.url));
+if (existsSync(envClientFile)) {
+  process.loadEnvFile(envClientFile);
+}
 
 export default defineConfig({
-  plugins: [wasp(), tailwindcss()],
+  plugins: [wasp(), tailwindcss(), llmsTxt()],
   server: {
     open: true,
   },
 });
+
+function llmsTxt(): Plugin {
+  return {
+    name: "opensaas-llms-txt",
+    apply: "build",
+    async generateBundle() {
+      this.emitFile({
+        type: "asset",
+        fileName: "llms.txt",
+        source: await generateLlmsTxt(),
+      });
+    },
+  };
+}
